<Project Sdk="Microsoft.NET.Sdk">

 <PropertyGroup>
 <TargetFramework>net8.0-windows</TargetFramework>
 <UseWPF>true</UseWPF>
 <Nullable>enable</Nullable>
 <ImplicitUsings>enable</ImplicitUsings>
 <RootNamespace>VisionShell.Plugins.ThorlabsKinesisStage</RootNamespace>

 <PlatformTarget>x64</PlatformTarget>
 <Prefer32Bit>false</Prefer32Bit>

 <!-- Output directly to the plugin folder so PluginLoader can find plugin.json and DLL -->
 <OutputPath>..\..\..\..\bin\$(Configuration)\app\plugins\thorlabs-kinesis-stage\</OutputPath>
 <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
 <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
 </PropertyGroup>

 <ItemGroup>
 <ProjectReference Include="..\..\..\VisionShell.Core\VisionShell.Core.csproj">
 <Private>false</Private>
 <ExcludeAssets>runtime</ExcludeAssets>
 </ProjectReference>
 </ItemGroup>

 <ItemGroup>
 <Reference Include="tlmc_xa_dotnet">
 <HintPath>libs\tlmc_xa_dotnet.dll</HintPath>
 <Private>true</Private>
 </Reference>
 </ItemGroup>

 <ItemGroup>
 <None Update="plugin.json">
 <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
 </None>
 </ItemGroup>

</Project>
