<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VisionShell.Plugins.ThorlabsSC30Shutter</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>..\..\..\..\bin\$(Configuration)\app\bridges\thorlabs-sc30-x86\driver\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\VisionShell.Core\VisionShell.Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
<None Include="..\..\..\..\TL_Devices\TL_Device_Plugins\TL_SC30_Plugin.dll" Link="TL_SC30_Plugin.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\..\..\TL_Devices\TL_Device_Plugins\TL_SC30_Plugin_Configuration.xml" Link="TL_SC30_Plugin_Configuration.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
